# 数据库（使用本机已安装的 PostgreSQL，库: memorylink，schema: memorylink）
DB_URL=jdbc:postgresql://localhost:5432/memorylink?currentSchema=memorylink
DB_USER=memorylink
DB_PASSWORD=memorylink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 对象存储（S3 兼容，本地用 MinIO）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=memorylink
MINIO_SECRET_KEY=memorylink123
MINIO_BUCKET=memorylink

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 安全
JWT_SECRET=please-change-me-in-production
